NODE_ENV=development
PORTA=3000
BANCO_NOME=criar_banco
BANCO_HOST=localhost
BANCO_PORTA=5432
BANCO_USUARIO=
BANCO_SENHA=
BANCO_SSL=false
BANCO_SSL_REJEITAR_NAO_AUTORIZADO=true
BANCO_SSL_CA_BASE64=
BANCO_POOL_MAX=5
BANCO_POOL_OCIOSO_MS=30000
BANCO_CONEXAO_TEMPO_LIMITE_MS=5000
BANCO_CONEXAO_TEMPO_MAXIMO_SEGUNDOS=300
BANCO_COMANDO_TEMPO_LIMITE_MS=15000
BANCO_CONSULTA_TEMPO_LIMITE_MS=20000
BANCO_BLOQUEIO_TEMPO_LIMITE_MS=5000
BANCO_TRANSACAO_OCIOSA_TEMPO_LIMITE_MS=15000

# Alternativa às variáveis BANCO_* para ambientes gerenciados:


FRONTEND_URL=http://localhost:5173
JWT_SECRET=
JWT_TEMPO_EXPIRACAO=8h
LOGIN_LIMITE_CONTA=5
LOGIN_LIMITE_IP=20
LOGIN_JANELA_MINUTOS=15
LOGIN_BLOQUEIO_MINUTOS=15
TRUST_PROXY_HOPS=0
DIGITALOCEAN_CONFIAR_IP=false
API_REQUISICOES_CONCORRENTES=100
API_LIMITE_JANELA_MS=60000
API_LIMITE_MAXIMO=1200
PUBLICO_LIMITE_JANELA_MS=900000
PUBLICO_LIMITE_MAXIMO=5
BAIRROS_CACHE_MS=300000
PG_DUMP_CAMINHO=
BACKUP_TEMPO_LIMITE_MS=600000
BACKUP_CONEXAO_TEMPO_LIMITE_SEGUNDOS=10
BACKUP_MAX_FILA_BANCO=2
BACKUP_BANCO_TAMANHO_MAXIMO_BYTES=2147483648
BACKUP_RETENCAO_TEMPORARIA_MS=900000
# Chave exclusiva de 32 bytes em hexadecimal. Guardar fora do banco, com cópia segura.
# Gerar: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BACKUP_ASSINATURA_CHAVE=
# pg_restore da mesma versão principal do PostgreSQL (18).
PG_RESTORE_CAMINHO=pg_restore
RESTORE_DRENAGEM_MS=30000
# Proteções internas de infraestrutura, nunca configurações do usuário final.
RESTORE_UPLOAD_MAX_BYTES=268435456
RESTORE_UPLOAD_TIMEOUT_MS=900000
RESTORE_PROCESSAMENTO_TIMEOUT_MS=1800000
RESTORE_DISCO_RESERVA_BYTES=268435456
RESTORE_MEMORIA_LIVRE_MIN_BYTES=134217728
RESTORE_EXPANSAO_MAX_BYTES=2147483648
RESTORE_REGISTRO_MAX_BYTES=8388608
# Obrigatório para PostgreSQL remoto: orçamento de espaço livre verificado pelo suporte.
# Em PostgreSQL local, sem este valor, mede o filesystem do data_directory.
RESTORE_BANCO_DISPONIVEL_BYTES=
RELATORIO_LIMITE_REGISTROS=50000

WHATSAPP_WEBHOOK_VERIFY_TOKEN=
META_APP_SECRET=
META_APP_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
META_GRAPH_API_VERSION=
META_REQUISICAO_TIMEOUT_MS=10000
META_TEMPLATES_SINCRONIZACAO_AUTOMATICA=true
META_TEMPLATES_SINCRONIZACAO_ATRASO_INICIAL_MS=5000
META_TEMPLATES_SINCRONIZACAO_INTERVALO_MS=900000
WHATSAPP_OPTOUT_BUTTON_ID=nao_quero_mais_receber
